# Copia este fichero como .env

# Tu bot de Telegram (la clave te la da BotFather). No se la ensenes a nadie.
TELEGRAM_BOT_TOKEN=
# Tu numero de usuario de Telegram: la mini app solo te deja entrar a ti.
TELEGRAM_MI_ID=

# La direccion https de tu mini app: la del tunel de pruebas o la de tu dominio.
# Ejemplo: https://app.tudominio.com
MINIAPP_URL=
# El puerto de tu ordenador donde escucha el programa.
MINIAPP_PUERTO=8080

# Opcional: tu clave de GMGN (gratis en https://gmgn.ai/ai) y tu propio nodo.
GMGN_API_KEY=
SOLANA_RPC=
