# Copia este fichero como .env

# Tu bot de Telegram (la clave te la da BotFather)
TELEGRAM_BOT_TOKEN=
# Tu numero de usuario de Telegram, para que solo te conteste a ti.
# Si no lo sabes, dejalo vacio, arranca el bot, escribele y te lo dice.
TELEGRAM_MI_ID=

# Opcional: tu propio nodo de Solana (Helius, Alchemy...). Si no, el publico (1 pregunta por segundo).
SOLANA_RPC=
# Cuantos saltos hacia atras como mucho
SALTOS=6
# Cuantas operaciones recientes se leen de cada billetera
OPERACIONES=30
# Envios de menos SOL que esto no cuentan
MINIMO_SOL=0.01
