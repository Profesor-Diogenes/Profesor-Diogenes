# Copia este fichero como .env

# Tu bot de Telegram (la clave te la da BotFather)
TELEGRAM_BOT_TOKEN=
# Tu numero de usuario de Telegram, para que solo te conteste a ti.
TELEGRAM_MI_ID=

# Opcional: tu clave de GMGN. La sacas gratis en https://gmgn.ai/ai
# Si lo dejas vacio, se usa la clave publica de pruebas de GMGN.
GMGN_API_KEY=
# Opcional: tu propio nodo de Solana. Si no, el publico (1 pregunta por segundo).
SOLANA_RPC=
# A cuantos pagadores se les busca su propio pagador (cada uno, unos segundos mas)
PAGADORES_ATRAS=8
