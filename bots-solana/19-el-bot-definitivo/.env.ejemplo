# Copia este fichero como .env. Lo que pongas aqui vale para todas las piezas.

# Tu bot de Telegram (la clave te la da BotFather)
TELEGRAM_BOT_TOKEN=
# Tu numero de usuario de Telegram, para que solo te conteste a ti.
TELEGRAM_MI_ID=

# Opcional: tu clave de GMGN. La sacas gratis en https://gmgn.ai/ai
# Si lo dejas vacio, se usa la clave publica de pruebas de GMGN.
GMGN_API_KEY=

# Opcional: tu propio nodo (Helius, Alchemy, QuickNode...). Si no, el publico de Solana.
SOLANA_RPC=
SOLANA_WS=

# Bot en papel: lo que se pierde en cada compra y en cada venta. 0.03 = 3 %
COMISION=0.03
