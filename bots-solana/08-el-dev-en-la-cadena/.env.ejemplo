# Copia este fichero como .env y pon tu clave de GMGN.
# La sacas gratis en https://gmgn.ai/ai
# Si lo dejas vacio, el programa usa la clave publica de pruebas de GMGN.
GMGN_API_KEY=

# Tu bot de Telegram (la clave te la da BotFather)
TELEGRAM_BOT_TOKEN=
# Tu numero de usuario de Telegram, para que solo te conteste a ti.
# Si no lo sabes, dejalo vacio, arranca el bot, escribele y te lo dice.
TELEGRAM_MI_ID=

# Opcional: tu propio nodo de Solana (Helius, Alchemy...). Si no, el publico.
SOLANA_RPC=
# Cuantas operaciones del creador se leen en el nodo (1 por segundo)
OPERACIONES=40
