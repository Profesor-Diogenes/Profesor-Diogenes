# Tu bot de Telegram (la clave te la da BotFather). Por aquí te llegan los avisos.
TELEGRAM_BOT_TOKEN=
# Tu número de usuario de Telegram, para que el bot solo te conteste a ti.
# Si no lo sabes, déjalo vacío, arranca, escríbele al bot y te lo dice.
TELEGRAM_MI_ID=

# La clave de aplicación de TU cuenta de Telegram (se saca en my.telegram.org -> API development tools).
# Hace falta porque un bot no puede leer los grupos en los que estás tú: los lee tu cuenta.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
