# Copia este archivo como .env y rellena TUS datos. El .env no se comparte nunca.

# Clave de tu bot de Telegram (te la da @BotFather al crear el bot)
TELEGRAM_TOKEN=TU_TOKEN_AQUI
# Tu número de chat. Si no lo sabes, arranca "python bot.py", escríbele y mira lo que sale en la terminal.
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# Archivo con los posts recogidos. Para probar, el de ejemplo.
POSTS=posts_ejemplo.json
# SOLO PARA PROBAR con los posts de ejemplo: hace como si hoy fuera este día.
# Cuando uses tus posts de verdad, BORRA esta línea.
HOY=2026-11-09

# Cómo se llama la orden de Claude Code en tu ordenador (normalmente, claude)
CLAUDE_ORDEN=claude
# Tope de me gusta al día (lo das tú a mano; es para que no te pases)
TOPE_ME_GUSTA=20
# Espera entre publicación y publicación, en segundos (de 1 a 3 minutos)
ESPERA_MIN_SEG=60
ESPERA_MAX_SEG=180
