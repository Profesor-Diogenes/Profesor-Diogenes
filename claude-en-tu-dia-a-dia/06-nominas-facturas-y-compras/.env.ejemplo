# Copia este archivo como .env si quieres cambiar algo. Aquí no hay claves:
# todo se queda en tu ordenador. Si no creas el .env, se usan estos valores.

# Movimientos del banco (los del capítulo 2, o el archivo de ejemplo)
MOVIMIENTOS=movimientos_ejemplo.csv
# Historial que descargas de la tienda en línea, pasado a pedido;fecha;tipo;importe
PEDIDOS=pedidos_tienda_ejemplo.csv

# Cómo sale cada cosa en el concepto del banco (separado por comas)
PALABRAS_TIENDA=TIENDA ONLINE
PALABRAS_LUZ=LUZ, GAS

# Días de margen entre el pedido y el cargo (la tienda cobra al enviar)
MARGEN_DIAS=5
