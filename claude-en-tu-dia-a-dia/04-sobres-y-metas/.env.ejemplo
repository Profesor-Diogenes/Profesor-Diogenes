# Copia este archivo como .env y rellena TUS datos. El .env no se comparte nunca.

# Archivo de movimientos (el que baja cada mañana el capítulo 2, o el de ejemplo)
MOVIMIENTOS=movimientos_ejemplo.csv
# Si ese archivo trae varias cuentas, la de ahorro (columna "cuenta"). Vacío = todas.
CUENTA_AHORRO=
# Tu punto de partida (comprobado a mano el día de corte), tus reglas y tus ajustes
PARTIDA=partida_ejemplo.json
REGLAS=reglas.txt
AJUSTES=ajustes_ejemplo.csv

# Solo si quieres el informe por Telegram (python sobres.py --telegram)
TELEGRAM_TOKEN=TU_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI
