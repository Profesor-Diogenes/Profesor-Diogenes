# Copia este archivo como .env y rellena TUS datos. El .env no se comparte nunca.

# Clave de la API del servicio (en su panel: API Keys -> Generate New API Key)
UPLOAD_POST_CLAVE=TU_CLAVE_AQUI
# Nombre del perfil donde conectaste tus redes (en su panel: User Management / Manage Users)
UPLOAD_POST_PERFIL=TU_PERFIL_AQUI
