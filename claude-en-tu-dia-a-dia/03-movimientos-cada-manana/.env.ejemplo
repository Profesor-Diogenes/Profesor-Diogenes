# Copia este archivo como .env y rellena TUS datos. El .env no se comparte nunca.

# Clave de tu bot de Telegram (te la da @BotFather al crear el bot)
TELEGRAM_TOKEN=TU_TOKEN_AQUI
# Tu número de chat. Si no lo sabes, arranca el bot, escríbele y mira lo que sale en la terminal.
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# Archivo de movimientos (el que baja cada mañana el capítulo 2, o el de ejemplo)
MOVIMIENTOS=movimientos_ejemplo.csv
# A partir de cuántos euros un cargo sale en /alertas
ALERTA_EUROS=100
