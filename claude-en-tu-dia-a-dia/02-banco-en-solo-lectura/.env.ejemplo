# Copia este archivo como .env y rellena TUS datos. El .env no se comparte nunca.
# Todos estos datos te los da tu proveedor de banca abierta al registrar tu aplicación.

# Dirección de la API de tu proveedor
PROVEEDOR_API=https://api.TU_PROVEEDOR.ejemplo
# Identificador de tu aplicación en el portal del proveedor
APP_ID=TU_ID_DE_APLICACION_AQUI
# Nombre del archivo de tu llave privada (ponlo en esta carpeta; nunca lo compartas)
LLAVE_PRIVADA=TU_LLAVE_PRIVADA.pem
# Emisor y audiencia del JWT: los indica la documentación de tu proveedor
JWT_EMISOR=TU_EMISOR_AQUI
JWT_AUDIENCIA=TU_AUDIENCIA_AQUI
# Tu banco, tal y como lo llama tu proveedor, y su país
BANCO_NOMBRE=TU_BANCO_AQUI
BANCO_PAIS=ES
# Adónde vuelve el navegador después de dar el permiso (la que registraste en el portal)
REDIRECT_URL=https://TU_WEB.ejemplo/vuelta
# Por cuántos días pides el permiso (lo máximo lo pone tu banco)
DIAS_PERMISO=90

# Aviso por Telegram (opcional: si lo dejas así, el aviso sale solo en pantalla)
TELEGRAM_TOKEN=TU_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI
# Avisar cuando al permiso le queden menos de estos días
AVISO_DIAS=20
